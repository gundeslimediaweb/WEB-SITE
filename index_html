 document.getElementById("saveSector").addEventListener("click",()=>{applySector(val("settingsSector"));toast("Sektör görünümü güncellendi.")});
 document.getElementById("settingsForm").addEventListener("submit",e=>{
  e.preventDefault();
  const f=e.currentTarget;
  const old={...data.settings};
  data.settings={businessName:f.elements.businessName.value.trim(),ownerName:f.elements.ownerName.value.trim(),businessPhone:f.elements.businessPhone.value.trim(),businessAddress:f.elements.businessAddress.value.trim()};
  setActivity("İşletme ayarları güncellendi");
  if(!persist()){data.settings=old;return}
  document.getElementById("businessSubtitle").textContent=(data.settings.businessName||"İşletme yönetim merkezi")+" · "+SECTORS[data.sector];
  toast("İşletme bilgileri kaydedildi.");
 });
 ["customerSearch","customerFilter","stockSearch","orderSearch","orderStatusFilter","serviceSearch","serviceStatusFilter","propertySearch","propertyStatusFilter","phoneSearch","phoneStatusFilter","taskSearch","taskStatusFilter"].forEach(id=>{
  const el=document.getElementById(id);if(el)el.addEventListener("input",renderAll);
