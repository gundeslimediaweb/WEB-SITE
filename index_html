 ].filter(([k,v])=>v!==""&&v!==null&&v!==undefined);
 const w=window.open("","_blank","width=800,height=850");
 if(!w){toast("Yazdırma penceresi engellendi. Tarayıcı açılır pencerelerine izin ver.");return}
 w.document.write(`<!doctype html><html lang="tr"><head><meta charset="utf-8"><title>Servis Formu</title><style>body{font:14px Arial;padding:30px;color:#182338}h1{font-size:22px}p{color:#667}table{width:100%;border-collapse:collapse}td{padding:10px;border-bottom:1px solid #ddd;vertical-align:top}td:first-child{width:32%;font-weight:bold}footer{margin-top:55px;display:flex;justify-content:space-between}@media print{button{display:none}}</style></head><body><h1>Gündeşli Soft · Ofis360</h1><p>Teknik Servis Formu</p><table>${rows.map(([k,v])=>`<tr><td>${esc(k)}</td><td>${esc(v)}</td></tr>`).join("")}</table><footer><span>Müşteri imzası: __________________</span><span>Yetkili imzası: __________________</span></footer><script>window.onload=()=>window.print()<\/script></body></html>`);
 w.document.close();
