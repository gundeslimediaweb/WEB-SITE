<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Gündeşli Media | Kayıt Merkezi</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #0b101d; color: #e5eaf4; font: 14px/1.6 system-ui, sans-serif; }
    header { padding: 24px 5%; border-bottom: 1px solid #293449; display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap; }
    h1, h2, h3, p { margin: 0 0 12px; }
    h1 { font-size: 24px; }
    small, .muted { color: #9baac0; }
    strong.gold { color: #d6b77b; letter-spacing: 2px; }
    main { max-width: 1250px; margin: auto; padding: 24px; }
    nav { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
    button, input, select, textarea { font: inherit; border: 1px solid #35435c; border-radius: 9px; padding: 11px; color: inherit; background: #141e30; }
    button { cursor: pointer; }
    button:hover, button:focus-visible { border-color: #d6b77b; }
    button.primary { background: #d6b77b; color: #141925; font-weight: 700; }
    button.danger { color: #fda4af; }
    input, select, textarea { width: 100%; margin: 5px 0 12px; }
    label { display: block; color: #bdc9db; }
    form { max-width: 650px; }
    section, .card { background: #111a2b; border: 1px solid #28354b; border-radius: 15px; padding: 20px; margin-bottom: 16px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
    .metric { font-size: 32px; font-weight: 700; color: #d6b77b; }
    .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .notice { padding: 12px; border-left: 3px solid #d6b77b; background: #20283a; margin-bottom: 20px; }
    .entry { border-top: 1px solid #293449; padding: 14px 0; overflow-wrap: anywhere; }
    .entry:first-child { border: 0; }
    .tag { display: inline-block; background: #26364d; border-radius: 6px; padding: 3px 8px; font-size: 12px; }
    a { color: #d6b77b; }
    button:disabled { opacity: .5; }
    @media(max-width: 600px) {
      main { padding: 14px; }
      header { padding: 18px; }
      h1 { font-size: 20px; }
      .card, section { padding: 15px; }
    }
  </style>
</head>
<body>
  <header>
    <div>
      <strong class="gold">GÜNDEŞLİ MEDIA</strong>
      <h1>Kayıt Merkezi</h1>
      <small>Üyelik · Referans · Yönetim</small>
    </div>
    <div id="session"></div>
  </header>
  <main id="app"></main>
  <script>
    'use strict';
    const KEY = 'gmkm_v1',
          OLD = 'gundesli_media_command_center_v3',
          $ = s => document.querySelector(s),
          E = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])),
          id = () => crypto.randomUUID(),
          now = () => Date.now(),
          date = t => new Date(t).toLocaleString('tr-TR'),
          token = () => Array.from(crypto.getRandomValues(new Uint8Array(24)), x => x.toString(16).padStart(2, '0')).join('');

    let d = { users: [], apps: [], invites: [], mail: [], tests: [], logs: [], mode: 'referral_only', legacy: null },
        me = null,
        page = 'home';

    try {
      let saved = JSON.parse(localStorage.getItem(KEY));
      if (saved) d = saved;
      else d.legacy = JSON.parse(localStorage.getItem(OLD));
    } catch {}

    const save = () => localStorage.setItem(KEY, JSON.stringify(d)),
          log = s => { d.logs.unshift({ at: now(), actor: me?.username || 'Aday', text: s }); save(); },
          admin = () => me?.role === 'founder',
          staff = () => admin() || me?.role === 'board',
          active = u => u && u.status === 'Aktif',
          norm = s => s.toLocaleLowerCase('tr').replace(/ı/g, 'i').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '.').replace(/^\.|\.$/g, ''),
          username = n => {
            let b = norm(n) || 'uye', v = b, i = 2;
            while (d.users.some(u => u.username === v) || d.apps.some(a => a.username === v)) v = b + i++;
            return v;
          },
          find = x => d.users.find(u => u.id === x),
          B = (t, a, v = '') => `<button data-a="${E(a)}" data-v="${E(v)}">${E(t)}</button>`,
          field = (n, l, t = 'text', extra = '') => `<label>${l}<input name="${n}" type="${t}" ${extra}></label>`,
          form = (a, body, t) => `<form data-form="${a}">${body}<button class="primary">${t}</button></form>`,
          entry = (title, body, actions = '') => `<div class="entry"><h3>${E(title)}</h3>${body}<div class="row">${actions}</div></div>`,
          list = (arr, fn) => arr.map(fn).join('') || '<p class="muted">Kayıt bulunmuyor.</p>';

    async function hash(p, s) {
      let k = await crypto.subtle.importKey('raw', new TextEncoder().encode(p), 'PBKDF2', false, ['deriveBits']);
      return Array.from(new Uint8Array(await crypto.subtle.deriveBits({ name: 'PBKDF2', salt: new TextEncoder().encode(s), iterations: 120000, hash: 'SHA-256' }, k, 256)), x => x.toString(16).padStart(2, '0')).join('');
    }

    async function credentials(p) {
      let salt = token();
      return { salt, hash: await hash(p, salt) };
    }

    function otp(email, purpose, target) {
      d.mail.filter(m => m.target === target && m.purpose === purpose && !m.used).forEach(m => m.used = true);
      let code = String(100000 + crypto.getRandomValues(new Uint32Array(1))[0] % 900000);
      d.mail.unshift({ id: id(), email, purpose, target, code, created: now(), expires: now() + 900000, tries: 0, used: false, sent: false });
      save();
    }

    function verify(email, code, purpose) {
      let m = d.mail.find(x => x.email === email && x.purpose === purpose && !x.used);
      if (!m || m.expires < now() || m.tries >= 5) throw Error('Kod geçersiz veya süresi dolmuş.');
      m.tries++;
      save();
      if (m.code !== code) throw Error('Kod yanlış.');
      m.used = true;
      save();
      return m;
    }

    function render() {
      $('#session').innerHTML = me ? E(me.name) + ' · ' + E(me.role) + ' ' + B('Çıkış', 'logout') : 'Yerel prototip';
      let h = '<div class="notice">Yerel test sürümü: Veriler bu tarayıcıda saklanır. Gerçek üyelik ve güvenlik için sunucu gereklidir.</div>';
      
      if (!d.users.some(u => u.role === 'founder')) {
        $('#app').innerHTML = h + '<section><h2>İlk kurulum · Kurucu hesabı</h2>' + form('setup', field('name', 'Ad soyad', 'text', 'required') + field('email', 'Gmail', 'email', 'required') + field('password', 'Şifre', 'password', 'required minlength="10"'), 'Kurucu oluştur') + '</section>';
        return;
      }

      if (!me) {
        let invite = new URLSearchParams(location.search).get('invite'),
            r = d.invites.find(x => x.token === invite && !x.used && x.expires > now()),
            ref = find(r?.ref);

        $('#app').innerHTML = h + '<nav>' + B('Giriş', 'page', 'home') + B('Başvuru', 'page', 'apply') + B('Posta doğrulama', 'page', 'verify') + B('Şifremi unuttum', 'page', 'reset') + '</nav><section>' +
          (page === 'apply'
            ? '<h2>Üyelik başvurusu</h2>' + (ref ? '<p>Referans: ' + E(ref.name) + ' · ' + E(ref.id) + '</p>' : '') + (d.mode === 'closed' ? '<p>Başvurular kapalı.</p>' : form('apply', field('name', 'Ad soyad', 'text', 'required') + field('email', 'Gmail', 'email', 'required') + field('phone', 'Telefon', 'tel', 'required') + field('district', 'İlçe', 'text', 'required') + field('profession', 'Meslek') + field('password', 'Şifre', 'password', 'required minlength="10"') + '<label><input style="width:auto" type="checkbox" required> Başvuru bilgilerimin üyelik değerlendirmesi için kullanılmasını kabul ediyorum.</label>', 'Başvur'))
            : page === 'verify'
              ? '<h2>Posta doğrulama</h2>' + form('verify', field('email', 'Gmail', 'email', 'required') + field('code', '6 haneli kod', 'text', 'required pattern="[0-9]{6}"'), 'Doğrula') + form('resend', field('email', 'Gmail', 'email', 'required'), 'Yeni kod iste')
              : page === 'reset'
                ? '<h2>Şifre yenileme</h2>' + form('requestReset', field('email', 'Gmail', 'email', 'required'), 'Kod iste') + form('reset', field('email', 'Gmail', 'email', 'required') + field('code', 'Kod', 'text', 'required') + field('password', 'Yeni şifre', 'password', 'required minlength="10"'), 'Şifreyi yenile')
                : '<h2>Hesabınıza giriş yapın</h2>' + form('login', '<label>Giriş türü<select name="role"><option value="member">Üye</option><option value="reference">Referans</option><option value="board">Yönetim</option><option value="founder">Kurucu</option></select></label>' + field('username', 'Kullanıcı adı veya Gmail', 'text', 'required') + field('password', 'Şifre', 'password', 'required'), 'Giriş yap')
          ) + '</section>';
        return;
      }

      let tabs = staff() ? ['home', 'apps', 'users', 'tests', 'logs', ...(admin() ? ['mail', 'settings', 'legacy'] : [])] : ['home', ...(me.role === 'reference' ? ['invites'] : [])];
      if (!tabs.includes(page)) page = 'home';
      let names = { home: 'Genel bakış', apps: 'Başvurular', users: 'Üyeler', tests: 'Aktiflik', logs: 'İşlem geçmişi', mail: 'Posta doğrulama', settings: 'Ayarlar', legacy: 'Eski kayıtlar', invites: 'Davet merkezi' };
      h += '<nav>' + tabs.map(x => B(names[x], 'page', x)).join('') + '</nav>';
      let body = '';

      if (page === 'home') {
        body = '<h2>Genel bakış</h2>' + (staff()
          ? '<div class="grid">' + [['Üye', d.users.length], ['Bekleyen', d.apps.filter(a => a.status === 'Bekliyor').length], ['Posta kuyruğu', d.mail.filter(m => !m.used && !m.sent && m.expires > now()).length], ['Aktif test', d.tests.filter(t => t.end > now()).length]].map(([n, v]) => `<div class="card">${n}<div class="metric">${v}</div></div>`).join('') + '</div>'
          : '<div class="card"><h3>' + E(me.name) + '</h3>Üye kimliği: ' + E(me.id) + '<br>Kullanıcı adı: ' + E(me.username) + '<br>Durum: ' + E(me.status) + '</div>') +
          (!staff() ? list(d.tests.filter(t => t.end > now() && t.targets.includes(me.id) && !t.responses.includes(me.id)), t => entry(t.title, '<p>Katılımınızı kaydedin.</p>', B('Katılıyorum', 'respond', t.id))) : '');
      }
      if (page === 'apps') body = '<h2>Başvurular</h2>' + list(d.apps, a => entry(a.name, `<p>${E(a.email)} · ${E(a.phone)} · ${E(a.district)}<br>${E(a.username)} · ${a.verified ? 'Posta doğrulandı' : 'Doğrulama bekliyor'} · ${E(a.status)}<br>Referans: ${E(find(a.ref)?.name || 'Yok')}</p>`, admin() && a.status === 'Bekliyor' ? (a.verified ? B('Onayla', 'approve', a.id) : '') + B('Reddet', 'reject', a.id) : ''));
      if (page === 'users') body = '<h2>Üye yönetimi</h2><input id="search" placeholder="İsim veya kullanıcı adı ara"><div id="users">' + users('') + '</div>';
      if (page === 'mail') body = '<h2>Posta doğrulama kuyruğu</h2>' + list(d.mail, m => entry(m.email, `<p>${E(m.purpose)} · ${m.used ? 'Kullanıldı' : m.expires < now() ? 'Süresi doldu' : m.sent ? 'Gönderildi olarak işaretlendi' : 'Gönderim bekliyor'} · ${date(m.expires)}</p>`, !m.used && m.expires > now() ? B('Gmail taslağı', 'gmail', m.id) + B('Gönderildi işaretle', 'sent', m.id) : ''));
      if (page === 'settings') body = '<h2>Kayıt politikası</h2>' + form('settings', `<select name="mode">${['closed', 'referral_only', 'open'].map((v, i) => `<option value="${v}" ${d.mode === v ? 'selected' : ''}>${['Kapalı', 'Sadece referans', 'Açık'][i]}</option>`).join('')}</select>`, 'Kaydet') + B('JSON yedeği indir', 'export');
      if (page === 'invites') body = '<h2>Referans kartı</h2><p>' + E(me.name) + ' · ' + E(me.id) + '</p>' + B('Yeni davet oluştur ve kopyala', 'invite') + '<p id="inviteout"></p>' + list(d.invites.filter(i => i.ref === me.id), i => entry(date(i.created), '<p>' + (i.used ? 'Kullanıldı' : i.expires < now() ? 'Geçersiz' : 'Aktif') + '</p>'));
      if (page === 'tests') body = '<h2>Aktiflik kontrolü</h2>' + (admin() ? form('test', field('title', 'Test başlığı', 'text', 'required') + field('hours', 'Süre (saat)', 'number', 'required min="12" max="72" value="24"'), 'Test başlat') : '') + list(d.tests, t => entry(t.title, `<p>Bitiş: ${date(t.end)} · Katılım ${t.responses.length}/${t.targets.length}</p><p>Katılmayanlar: ${E(t.targets.filter(x => !t.responses.includes(x)).map(x => find(x)?.name || x).join(', '))}</p>`));
      if (page === 'logs') body = '<h2>İşlem geçmişi</h2>' + list(d.logs, l => entry(l.text, `<small>${E(l.actor)} · ${date(l.at)}</small>`));
      if (page === 'legacy') body = '<h2>Önceki sistem kayıtları</h2><p>Eski veriler değiştirilmeden saklanır; hesap açılması için yeni doğrulama gerekir.</p>' + (d.legacy ? Object.entries(d.legacy).filter(([k, v]) => Array.isArray(v)).map(([k, v]) => `<details><summary>${E(k)} (${v.length})</summary>${list(v, x => entry(x.name || x.fullName || x.message || x.id, '<p>' + E(x.status || x.title || '') + '</p>'))}</details>`).join('') : '<p>Bu tarayıcıda eski kayıt bulunamadı.</p>');

      $('#app').innerHTML = h + '<section>' + body + '</section>';
    }

    function users(q) {
      return list(d.users.filter(u => norm(u.name + ' ' + u.username).includes(norm(q))), u => entry(u.name, `<p>${E(u.username)} · ${E(u.email)} · ${E(u.role)} · ${E(u.status)}</p>`, admin() && u.role !== 'founder' ? B('Rol değiştir', 'role', u.id) + B('Durum değiştir', 'status', u.id) : ''));
    }

    function gmail(e) {
      return /^[a-z0-9.]+@gmail\.com$/i.test(e);
    }

    document.addEventListener('submit', async e => {
      let a = e.target.dataset.form;
      if (!a) return;
      e.preventDefault();
      let f = Object.fromEntries(new FormData(e.target)),
          email = (f.email || '').trim().toLowerCase();

      try {
        if (['setup', 'apply'].includes(a) && !gmail(email)) throw Error('Gmail adresi gerekli.');
        if (a === 'setup' && !d.users.length) {
          let u = { id: id(), name: f.name, username: username(f.name), email, role: 'founder', status: 'Aktif', ...await credentials(f.password) };
          d.users.push(u);
          me = u;
          log('Kurucu hesabı oluşturuldu');
        } else if (a === 'login') {
          let u = d.users.find(u => (u.username === f.username.toLowerCase() || u.email === f.username.toLowerCase()) && u.role === f.role);
          if (!active(u) || await hash(f.password, u.salt) !== u.hash) throw Error('Giriş bilgileri geçersiz.');
          me = u;
          page = 'home';
          log('Giriş yapıldı');
        } else if (a === 'apply' && !me) {
          if (d.mode === 'closed') throw Error('Başvurular kapalı.');
          let i = d.invites.find(i => i.token === new URLSearchParams(location.search).get('invite') && !i.used && i.expires > now() && active(find(i.ref)) && find(i.ref).role === 'reference');
          if (d.mode === 'referral_only' && !i) throw Error('Geçerli davet gerekli.');
          if (d.users.some(u => u.email === email) || d.apps.some(a => a.email === email && a.status === 'Bekliyor')) throw Error('Mevcut kayıt var.');
          let x = { id: id(), name: f.name.trim(), email, phone: f.phone, district: f.district, profession: f.profession, username: username(f.name), ref: i?.ref || null, status: 'Bekliyor', verified: false, ...await credentials(f.password) };
          d.apps.push(x);
          if (i) i.used = true;
          otp(email, 'verify', x.id);
          log('Başvuru alındı');
          page = 'verify';
          alert('Kurucunun kodu Gmail ile göndermesi bekleniyor.');
        } else if (a === 'verify' && !me) {
          let m = verify(email, f.code, 'verify'),
              x = d.apps.find(x => x.id === m.target);
          if (x) x.verified = true;
          log('Başvuru postası doğrulandı');
          alert('Doğrulandı. Yönetim onayı bekleniyor.');
        } else if (['resend', 'requestReset'].includes(a) && !me) {
          let purpose = a === 'resend' ? 'verify' : 'reset',
              x = purpose === 'verify' ? d.apps.find(x => x.email === email && !x.verified && x.status === 'Bekliyor') : d.users.find(x => x.email === email && active(x));
          if (x && !d.mail.some(m => m.target === x.id && m.purpose === purpose && now() - m.created < 60000)) otp(email, purpose, x.id);
          alert('Uygun kayıt varsa posta kuyruğuna alındı.');
        } else if (a === 'reset' && !me) {
          let m = verify(email, f.code, 'reset'),
              u = find(m.target);
          if (!active(u)) throw Error('Hesap kullanılamıyor.');
          Object.assign(u, await credentials(f.password));
          log('Şifre yenilendi');
          page = 'home';
        } else if (a === 'settings' && admin()) {
          d.mode = f.mode;
          log('Kayıt politikası değiştirildi');
        } else if (a === 'test' && admin()) {
          let hours = Number(f.hours);
          if (hours < 12 || hours > 72) throw Error('12–72 saat seçin.');
          d.tests.unshift({ id: id(), title: f.title, end: now() + hours * 3600000, targets: d.users.filter(u => active(u) && ['member', 'reference'].includes(u.role)).map(u => u.id), responses: [] });
          log('Aktiflik testi başlatıldı');
        }
        save();
        render();
      } catch (err) {
        alert(err.message);
      }
    });

    document.addEventListener('input', e => {
      if (e.target.id === 'search' && staff()) $('#users').innerHTML = users(e.target.value);
    });

    document.addEventListener('click', async e => {
      let b = e.target.closest('[data-a]');
      if (!b) return;
      let a = b.dataset.a, v = b.dataset.v;

      try {
        if (a === 'page') { page = v; render(); return; }
        if (a === 'logout') { me = null; page = 'home'; render(); return; }
        if (a === 'invite' && active(me) && me.role === 'reference') {
          d.invites.filter(i => i.ref === me.id && !i.used).forEach(i => i.used = true);
          let i = { id: id(), ref: me.id, token: token(), created: now(), expires: now() + 86400000, used: false };
          d.invites.unshift(i);
          log('Davet yenilendi');
          let url = new URL(location.href);
          url.search = '';
          url.hash = '';
          url.searchParams.set('invite', i.token);
          render();
          $('#inviteout').textContent = url.href;
          try { await navigator.clipboard.writeText(url.href); alert('Bağlantı kopyalandı.'); } catch {}
          return;
        }
        if (a === 'respond' && active(me)) {
          let t = d.tests.find(t => t.id === v && t.end > now() && t.targets.includes(me.id));
          if (t && !t.responses.includes(me.id)) {
            t.responses.push(me.id);
            log('Aktiflik katılımı kaydedildi');
          }
        }
        if (admin()) {
          let x = d.apps.find(x => x.id === v),
              u = find(v),
              m = d.mail.find(m => m.id === v);

          if (a === 'approve' && x?.verified && x.status === 'Bekliyor') {
            d.users.push({ ...x, id: id(), role: 'member', status: 'Aktif' });
            x.status = 'Onaylandı';
            log('Üyelik onaylandı: ' + x.name);
          }
          if (a === 'reject' && x?.status === 'Bekliyor') {
            let reason = prompt('Ret gerekçesi');
            if (reason?.trim().length >= 5) {
              x.status = 'Reddedildi';
              x.reason = reason;
              log('Başvuru reddedildi: ' + reason);
            }
          }
          if (a === 'role' && u && u.role !== 'founder') {
            let r = prompt('member / reference / board', u.role);
            if (['member', 'reference', 'board'].includes(r)) {
              u.role = r;
              log('Rol değiştirildi: ' + u.name);
            }
          }
          if (a === 'status' && u && u.role !== 'founder') {
            u.status = active(u) ? 'Askıya Alındı' : 'Aktif';
            log('Durum değiştirildi: ' + u.name);
          }
          if (a === 'gmail' && m && !m.used && m.expires > now()) {
            let url = 'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(m.email) + '&su=' + encodeURIComponent('GMKM doğrulama kodu') + '&body=' + encodeURIComponent('Kodunuz: ' + m.code + '\n15 dakika içinde kullanınız.');
            window.open(url, '_blank', 'noopener,noreferrer');
            return;
          }
          if (a === 'sent' && m) {
            m.sent = true;
            log('Posta gönderildi olarak işaretlendi');
          }
          if (a === 'export') {
            let url = URL.createObjectURL(new Blob([JSON.stringify(d, null, 2)], { type: 'application/json' })),
                link = document.createElement('a');
            link.href = url;
            link.download = 'gmkm-yedek.json';
            link.click();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
          }
        }
        save();
        render();
      } catch (err) {
        alert(err.message);
      }
    });

    if (new URLSearchParams(location.search).has('invite')) page = 'apply';
    render();
  </script>
</body>
</html>
