function restoreBackup(file){
 if(!file)return;
 if(file.size>20*1024*1024){toast("Yedek dosyası 20 MB sınırını aşıyor.");return}
 const reader=new FileReader();
 reader.onload=()=>{
  try{
   const packet=JSON.parse(reader.result);
   const incoming=packet?.data;
   if(!incoming||typeof incoming!=="object"||!LISTS.every(k=>Array.isArray(incoming[k])))throw new Error("Yedek dosyasının biçimi geçersiz.");
   if(!confirm("Geri yükleme mevcut bu tarayıcı verilerinin üzerine yazacak. Önce mevcut verilerinin yedeğini almanı öneririz. Devam edilsin mi?"))return;
   const old=data;
   const next=emptyData();
   for(const k of LISTS)next[k]=incoming[k].filter(x=>x&&typeof x==="object"&&!Array.isArray(x));
   next.settings=incoming.settings&&typeof incoming.settings==="object"?{...next.settings,...incoming.settings}:next.settings;
   next.sector=SECTORS[incoming.sector]?incoming.sector:"computer";
   next.activity=Array.isArray(incoming.activity)?incoming.activity.slice(0,80):[];
   data=next;
   if(!persist()){data=old;return}
   applySector(data.sector);renderAll();toast("Yedek geri yüklendi.");
  }catch(e){toast("Yedek okunamadı: "+e.message)}
  document.getElementById("restoreFile").value="";
 };
 reader.onerror=()=>toast("Dosya okunamadı.");
 reader.readAsText(file);
}
