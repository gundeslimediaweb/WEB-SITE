<script>
"use strict";
const DB_KEY="gundesliSoftOfis360_v2";
const SECTORS={
 computer:"Bilgisayar ve Güvenlik Sistemleri",
 realestate:"Gayrimenkul / Emlak",
 phone:"Telefoncu"
};
const LISTS=["customers","stock","orders","services","properties","phones","tasks"];
const emptyData=()=>({
 version:2,sector:"computer",customers:[],stock:[],orders:[],services:[],properties:[],phones:[],tasks:[],
 settings:{businessName:"",ownerName:"",businessPhone:"",businessAddress:""},
 activity:[]
});
let data=loadData(),editing=null,pendingServiceDraft=null,toastTimer=null;
function loadData(){
 try{
  const raw=localStorage.getItem(DB_KEY);
  if(!raw)return emptyData();
  const parsed=JSON.parse(raw);
  const base=emptyData();
  if(!parsed||typeof parsed!=="object"||Array.isArray(parsed))return base;
  for(const key of LISTS)base[key]=Array.isArray(parsed[key])?parsed[key].filter(x=>x&&typeof x==="object"&&!Array.isArray(x)):[];
  base.settings=parsed.settings&&typeof parsed.settings==="object"?{...base.settings,...parsed.settings}:base.settings;
  base.sector=SECTORS[parsed.sector]?parsed.sector:"computer";
  base.activity=Array.isArray(parsed.activity)?parsed.activity.slice(0,100):[];
  base.version=2;
  return base;
 }catch(e){console.error("Veri okunamadı:",e);return emptyData()}
}
function persist(){
 try{localStorage.setItem(DB_KEY,JSON.stringify(data));return true}
 catch(e){toast("Kayıt yapılamadı. Tarayıcı depolaması dolu veya kapalı olabilir.");console.error(e);return false}
}
function uid(){return crypto.randomUUID?crypto.randomUUID():"id-"+Date.now().toString(36)+"-"+Math.random().toString(36).slice(2)}
function today(){return new Date().toISOString().slice(0,10)}
function money(v){return new Intl.NumberFormat("tr-TR",{style:"currency",currency:"TRY",maximumFractionDigits:2}).format(Number(v)||0)}
function fmtDate(v){if(!v)return "—";const d=new Date(v+"T00:00:00");return Number.isNaN(d.getTime())?esc(v):d.toLocaleDateString("tr-TR")}
function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function val(id){return document.getElementById(id)?.value?.trim()||""}
function num(id){const v=val(id).replace(/\s/g,"").replace(",",".");return v===""?0:Number(v)}
function toast(msg){const el=document.getElementById("toast");el.textContent=msg;el.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove("show"),3200)}
function setActivity(label){data.activity.unshift({id:uid(),label,date:new Date().toISOString()});data.activity=data.activity.slice(0,80)}
function logAndSave(label){setActivity(label);if(!persist())return false;renderAll();return true}
function findCustomer(id){return data.customers.find(c=>c.id===id)}
function customerName(id){return findCustomer(id)?.name||"Müşteri kaydı yok"}
function activeCount(arr,statusField="status",closed=["Tamamlandı","Teslim edildi","İptal","Kapandı"]){return arr.filter(x=>!closed.includes(x[statusField])).length}
function currentPage(){return document.querySelector(".page.active")?.id.replace("page-","")||"dashboard"}
function gotoPage(page){
 const target=document.getElementById("page-"+page);if(!target)return;
 document.querySelectorAll(".page").forEach(x=>x.classList.toggle("active",x===target));
 document.querySelectorAll("#mainNav button").forEach(x=>x.classList.toggle("active",x.dataset.page===page));
 const nav=document.querySelector(`#mainNav button[data-page="${page}"]`);
 document.getElementById("topTitle").textContent=nav?nav.textContent.trim():page;
 document.getElementById("sidebar").classList.remove("open");
 window.scrollTo({top:0,behavior:"smooth"});
}
function applySector(sector){
 if(!SECTORS[sector])return;
 data.sector=sector;
 document.getElementById("sectorSwitcher").value=sector;
 document.getElementById("settingsSector").value=sector;
 document.getElementById("businessSubtitle").textContent=(data.settings.businessName||"İşletme yönetim merkezi")+" · "+SECTORS[sector];
 document.querySelectorAll("[data-sector]").forEach(el=>{
  const allowed=el.dataset.sector.split(",");
  el.hidden=!allowed.includes(sector);
 });
 const page=currentPage();
 const nav=document.querySelector(`#mainNav button[data-page="${page}"]`);
 if(nav&&nav.hidden)gotoPage("dashboard");
 if(!persist())return;
 renderAll();
}
function openModal(){document.getElementById("modalBackdrop").classList.add("open")}
function closeModal(){document.getElementById("modalBackdrop").classList.remove("open");document.getElementById("recordForm").reset();editing=null;pendingServiceDraft=null}
function field(label,name,type="text",options={}){
 const full=options.full?" full":"";
 let control="";
 if(type==="textarea")control=`<textarea id="f_${name}" name="${name}" ${options.required?"required":""} maxlength="${options.maxlength||1000}" placeholder="${esc(options.placeholder||"")}"></textarea>`;
 else if(type==="select")control=`<select id="f_${name}" name="${name}" ${options.required?"required":""}>${(options.options||[]).map(o=>`<option value="${esc(o.value)}">${esc(o.label)}</option>`).join("")}</select>`;
 else control=`<input id="f_${name}" name="${name}" type="${type}" ${options.required?"required":""} ${options.min!==undefined?`min="${options.min}"`:""} ${options.step?`step="${options.step}"`:""} ${options.maxlength?`maxlength="${options.maxlength}"`:""} placeholder="${esc(options.placeholder||"")}">`;
 return `<div class="field${full}"><label for="f_${name}">${esc(label)}${options.required?" *":""}</label>${control}</div>`;
}
function selectOptions(arr,first="Seçiniz"){
 return [{value:"",label:first},...arr.map(x=>({value:x,label:x}))];
}
const schema={
 customer:{title:"Müşteri kaydı",list:"customers",fields:[
  ["Ad soyad / işletme adı","name","text",{required:true,maxlength:160}],
  ["Telefon","phone","tel",{maxlength:40}],
  ["E-posta","email","email",{maxlength:160}],
  ["Adres","address","text",{maxlength:300,full:true}],
  ["Notlar","notes","textarea",{full:true}],
  ["İletişim izni","marketing","select",{options:[{value:"no",label:"İzin yok"},{value:"yes",label:"İzin var"}]}]
 ]},
 stock:{title:"Stok kaydı",list:"stock",fields:[
  ["Ürün / cihaz adı","name","text",{required:true,maxlength:160}],
  ["Stok kodu","code","text",{maxlength:80}],
  ["Kategori","category","text",{maxlength:100}],
  ["Miktar","quantity","number",{required:true,min:0,step:"1"}],
  ["Kritik stok seviyesi","minStock","number",{min:0,step:"1"}],
  ["Birim maliyet (₺)","buyPrice","number",{min:0,step:"0.01"}],
  ["Satış fiyatı (₺)","sellPrice","number",{min:0,step:"0.01"}],
  ["Tedarikçi","supplier","text",{maxlength:160}],
  ["Notlar","notes","textarea",{full:true}]
 ]},
 order:{title:"Satış / sipariş kaydı",list:"orders",fields:[
  ["İşlem numarası","code","text",{maxlength:80}],
  ["Müşteri","customerId","select",{options:[]}],
  ["İşlem türü","kind","select",{options:selectOptions(["Satış","Sipariş","Alış"])}],
  ["Tarih","date","date",{required:true}],
  ["Toplam tutar (₺)","total","number",{required:true,min:0,step:"0.01"}],
  ["Ödenen (₺)","paid","number",{min:0,step:"0.01"}],
  ["Durum","status","select",{options:selectOptions(["Bekliyor","Hazırlanıyor","Tamamlandı","İptal"],"Durum seç")}],
  ["Açıklama","notes","textarea",{full:true}]
 ]},
 service:{title:"Teknik servis kaydı",list:"services",fields:[
  ["Servis numarası","code","text",{maxlength:80}],
  ["Müşteri","customerId","select",{required:true,options:[]}],
  ["Cihaz / marka-model","device","text",{required:true,maxlength:180}],
  ["Seri numarası","serial","text",{maxlength:100}],
  ["Arıza / müşteri beyanı","problem","textarea",{required:true,full:true}],
  ["Yapılan işlem","work","textarea",{full:true}],
  ["Kabul tarihi","date","date",{required:true}],
  ["Teslim tarihi","dueDate","date"],
  ["Durum","status","select",{options:selectOptions(["Kabul edildi","İncelemede","Parça bekliyor","Onarımda","Teslime hazır","Teslim edildi"],"Durum seç")}],
  ["Servis ücreti (₺)","fee","number",{min:0,step:"0.01"}],
  ["Garanti / ek not","notes","textarea",{full:true}]
 ]},
 property:{title:"Gayrimenkul portföyü",list:"properties",fields:[
  ["Portföy başlığı","title","text",{required:true,maxlength:180}],
  ["İlan türü","kind","select",{options:selectOptions(["Satılık","Kiralık"])}],
  ["Mülk türü","propertyType","select",{options:selectOptions(["Daire","Müstakil ev","Arsa","İş yeri","Ofis","Dükkan","Diğer"])}],
  ["Konum","location","text",{required:true,maxlength:250}],
  ["Fiyat (₺)","price","number",{min:0,step:"0.01"}],
  ["Malik / ilgili müşteri","owner","text",{maxlength:160}],
  ["Telefon","phone","tel",{maxlength:40}],
  ["Durum","status","select",{options:selectOptions(["Aktif","İşlemde","Kapandı"],"Durum seç")}],
  ["Açıklama","notes","textarea",{full:true}]
 ]},
 phone:{title:"Telefon cihazı kaydı",list:"phones",fields:[
  ["Marka","brand","text",{required:true,maxlength:100}],
  ["Model","model","text",{required:true,maxlength:120}],
  ["IMEI / seri numarası","imei","text",{maxlength:100}],
  ["Alış fiyatı (₺)","buyPrice","number",{min:0,step:"0.01"}],
  ["Satış fiyatı (₺)","sellPrice","number",{min:0,step:"0.01"}],
  ["Durum","status","select",{options:selectOptions(["Stokta","Satıldı","Serviste","İade"],"Durum seç")}],
  ["Alış / kayıt tarihi","date","date"],
  ["Notlar","notes","textarea",{full:true}]
 ]},
 task:{title:"Görev / hatırlatma",list:"tasks",fields:[
  ["Görev başlığı","title","text",{required:true,maxlength:180}],
  ["İlgili kişi","person","text",{maxlength:160}],
  ["Son tarih","dueDate","date"],
  ["Öncelik","priority","select",{options:selectOptions(["Düşük","Normal","Yüksek","Acil"])}],
  ["Durum","status","select",{options:selectOptions(["Bekliyor","Devam ediyor","Tamamlandı"])}],
  ["Açıklama","notes","textarea",{full:true}]
 ]}
};
function newCode(type){const p={order:"SAT",service:"SRV",task:"GÖR"}[type]||type.toUpperCase();return p+"-"+new Date().getFullYear()+"-"+Math.random().toString(36).slice(2,7).toUpperCase()}
function openRecord(type,id=null){
 const cfg=schema[type];if(!cfg)return;
 if(type==="stock"&&!["computer","phone"].includes(data.sector)||type==="order"&&!["computer","phone"].includes(data.sector)||type==="service"&&!["computer","phone"].includes(data.sector)||type==="property"&&data.sector!=="realestate"||type==="phone"&&data.sector!=="phone"){toast("Bu kayıt aktif sektör için kullanılamıyor.");return}
 editing=id?{type,id}:null;
 const old=id?data[cfg.list].find(x=>x.id===id):null;
 if(id&&!old){toast("Kayıt bulunamadı.");return}
 document.getElementById("modalTitle").textContent=old?"Kaydı düzenle":cfg.title;
 const body=document.getElementById("modalBody");
 body.innerHTML=`<div class="form-grid">${cfg.fields.map(([label,name,kind,opt])=>{
  const options={...(opt||{})};
  if(name==="customerId"){
   options.options=[{value:"",label:"Müşteri seç"},...data.customers.map(c=>({value:c.id,label:c.name}))];
   if(type==="service")options.required=true;
  }
  return field(label,name,kind,options);
 }).join("")}</div>`;
 for(const [label,name,kind] of cfg.fields){
  const el=document.getElementById("f_"+name);if(!el)continue;
  let v=old?.[name]??"";
  if(name==="marketing")v=old?.marketing?"yes":"no";
  if(type==="order"&&name==="date"&&!v)v=today();
  if(type==="service"&&name==="date"&&!v)v=today();
  if(kind==="select"&&name==="status"&&!v)v=type==="service"?"Kabul edildi":type==="task"?"Bekliyor":type==="phone"?"Stokta":type==="property"?"Aktif":"Bekliyor";
  if(type==="order"&&name==="kind"&&!v)v="Satış";
  if(type==="task"&&name==="priority"&&!v)v="Normal";
  el.value=v;
 }
 openModal();
 if(type==="service"&&data.customers.length===0&&!id){
  pendingServiceDraft=Object.fromEntries(new FormData(document.getElementById("recordForm")).entries());
  toast("Önce müşteri eklemelisin. Form bilgilerini geçici olarak korumaya çalışacağız.");
 }
}
function getFormObject(){return Object.fromEntries(new FormData(document.getElementById("recordForm")).entries())}
function numericFields(type,obj){
 const fields={stock:["quantity","minStock","buyPrice","sellPrice"],order:["total","paid"],service:["fee"],property:["price"],phone:["buyPrice","sellPrice"]}[type]||[];
 for(const k of fields){if(obj[k]===""||obj[k]===undefined)obj[k]=0;obj[k]=Number(obj[k]);if(!Number.isFinite(obj[k])||obj[k]<0)throw new Error("Tutar ve miktarlar negatif olamaz.");}
 if(type==="order"&&Number(obj.paid)>Number(obj.total))throw new Error("Ödenen tutar toplam tutardan fazla olamaz.");
 if(type==="stock"&&!Number.isInteger(Number(obj.quantity)))throw new Error("Stok miktarı tam sayı olmalı.");
 if(type==="stock"&&!Number.isInteger(Number(obj.minStock)))throw new Error("Kritik stok miktarı tam sayı olmalı.");
}
function saveRecord(e){
 e.preventDefault();
 const type=editing?.type||document.getElementById("modalTitle").dataset.type;
 let resolvedType=editing?.type;
 if(!resolvedType){
  const title=document.getElementById("modalTitle").textContent;
  resolvedType=Object.keys(schema).find(k=>schema[k].title===title);
 }
 if(!resolvedType){toast("Kayıt türü belirlenemedi.");return}
 const cfg=schema[resolvedType],obj=getFormObject();
 try{
  numericFields(resolvedType,obj);
  if(resolvedType==="service"&&!findCustomer(obj.customerId))throw new Error("Geçerli bir müşteri seçmelisin.");
  if(resolvedType==="order"&&obj.customerId&&!findCustomer(obj.customerId))throw new Error("Seçilen müşteri bulunamadı.");
  if(resolvedType==="phone"&&obj.imei&&data.phones.some(p=>p.imei===obj.imei&&p.id!==editing?.id))throw new Error("Bu IMEI/seri numarası başka bir kayıtta var.");
  if(resolvedType==="stock"&&obj.code&&data.stock.some(p=>p.code===obj.code&&p.id!==editing?.id))throw new Error("Bu stok kodu zaten kayıtlı.");
  if(resolvedType==="service"&&!obj.code)obj.code=newCode("service");
  if(resolvedType==="order"&&!obj.code)obj.code=newCode("order");
  if(resolvedType==="task"&&!obj.status)obj.status="Bekliyor";
  if(resolvedType==="customer")obj.marketing=obj.marketing==="yes";
  const list=data[cfg.list],idx=editing?list.findIndex(x=>x.id===editing.id):-1;
  const prior=idx>=0?list[idx]:null;
  const record={...(prior||{}),...obj,id:prior?.id||uid(),createdAt:prior?.createdAt||today(),updatedAt:today()};
  if(resolvedType==="customer"&&pendingServiceDraft){/* draft flow handled separately */}
  if(idx>=0)list[idx]=record;else list.unshift(record);
  const label=(prior?"Güncellendi":"Oluşturuldu")+": "+(record.name||record.title||record.code||record.model||cfg.title);
  setActivity(label);
  if(!persist()){
   if(idx>=0)list[idx]=prior;else data[cfg.list]=list.filter(x=>x.id!==record.id);
   return;
  }
  closeModal();renderAll();toast(prior?"Kayıt güncellendi.":"Kayıt oluşturuldu.");
 }catch(err){toast(err.message||"Kayıt doğrulanamadı.")}
}
function deleteRecord(type,id){
 const cfg=schema[type];if(!cfg)return;
 const item=data[cfg.list].find(x=>x.id===id);if(!item)return;
 if(type==="customer"){
  const linked=data.services.some(x=>x.customerId===id)||data.orders.some(x=>x.customerId===id);
  if(linked){if(!confirm("Bu müşteriye bağlı servis veya satış kaydı var. Müşteri silinirse geçmiş bağlantısı kopabilir. Yine de silinsin mi?"))return}
 }
 if(!confirm("Bu kaydı silmek istediğine emin misin?"))return;
 const old=data[cfg.list];data[cfg.list]=old.filter(x=>x.id!==id);setActivity("Silindi: "+(item.name||item.title||item.code||item.model||cfg.title));
 if(!persist()){data[cfg.list]=old;return}
 renderAll();toast("Kayıt silindi.");
}
function editRecord(type,id){openRecord(type,id)}
function actionButtons(type,id){return `<div class="row-actions"><button class="btn small-btn" data-edit="${type}" data-id="${esc(id)}">Düzenle</button><button class="btn small-btn danger" data-delete="${type}" data-id="${esc(id)}">Sil</button></div>`}
function statusPill(s){
 const v=String(s||"—");
 const cls=/iptal|gecik/i.test(v)?"red":/tamam|teslim edildi|satıldı|kapandı/i.test(v)?"green":/bekliyor|parça|inceleme/i.test(v)?"amber":"blue";
 return `<span class="pill ${cls}">${esc(v)}</span>`;
}
function tableEmpty(cols,msg="Henüz kayıt bulunmuyor."){return `<tr><td colspan="${cols}" class="empty">${esc(msg)}</td></tr>`}
function renderCustomers(){
 const q=val("customerSearch").toLocaleLowerCase("tr");
 const filter=val("customerFilter");
 const rows=data.customers.filter(c=>(!q||[c.name,c.phone,c.email,c.address].some(v=>String(v||"").toLocaleLowerCase("tr").includes(q)))&&(!filter||(filter==="marketing"&&c.marketing)));
