  const create=e.target.closest("[data-create]");
  if(create){openRecord(create.dataset.create);return}
  const edit=e.target.closest("[data-edit]");
  if(edit){editRecord(edit.dataset.edit,edit.dataset.id);return}
  const del=e.target.closest("[data-delete]");
  if(del){deleteRecord(del.dataset.delete,del.dataset.id);return}
  const go=e.target.closest("[data-goto]");
  if(go){gotoPage(go.dataset.goto);return}
  const print=e.target.closest("[data-print-service]");
  if(print){printService(print.dataset.printService);return}
  const guide=e.target.closest("[data-guide]");
  if(guide){const q={service:"Teknik servis kaydı nasıl açılır?",stock:"Stok nasıl takip edilir?",backup:"Yedek nasıl alınır?",customer:"Müşteri nasıl eklenir?",sector:"Sektör nasıl değiştirilir?"}[guide.dataset.guide];document.getElementById("guideQuestion").value=q;document.getElementById("guideAnswer").textContent=guideAnswer(q)}
 });
