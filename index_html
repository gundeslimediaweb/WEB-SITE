function guideAnswer(q){
 const s=q.toLocaleLowerCase("tr");
 if(/servis|arıza|cihaz kabul/.test(s))return "1. Müşteri kaydı varsa Teknik Servis > Servis kabul bölümünü aç.\n2. Müşteriyi seç; cihaz ve arıza bilgilerini doldur.\n3. Kaydet. Durumu servis ekranından güncelle.\n4. Yazdır düğmesiyle doldurulmuş servis bilgilerini çıktı al.\n\nMüşteri henüz kayıtlı değilse önce Müşteriler bölümünden oluştur.";
 if(/stok|kritik|ürün/.test(s))return "1. Stok Yönetimi bölümüne gir.\n2. Ürün adını, miktarı, kritik seviyeyi ve fiyatları doldur.\n3. Kaydet. Kritik seviyeye inen kalemler Genel Bakış ekranında görünür.\n\nBu prototipte satış kaydı otomatik stok düşümü yapmaz; stok hareketleri modülü sonraki geliştirme aşamasında eklenmelidir.";
 if(/yedek|backup|aktar/.test(s))return "Ayarlar ve Yedekleme bölümünden JSON yedeği indir. CSV dışa aktarma rapor ve tablo işlemleri içindir. JSON yedeğini güvenli bir yerde sakla. Geri yükleme mevcut yerel verilerin üzerine yazar.";
 if(/müşteri|müşteri ekle/.test(s))return "Müşteriler bölümünü aç ve Müşteri ekle düğmesine bas. Ad-soyad/işletme adı zorunludur. Telefon, e-posta, adres ve notları ekleyip kaydet.";
 if(/sektör/.test(s))return "Üst menüdeki sektör listesinden Bilgisayar ve Güvenlik, Gayrimenkul veya Telefoncu seçeneklerinden birini seç. İlgili modüller görünür. Bu yerel prototipte sektör değişimi ayrı kullanıcı hesabı oluşturmaz.";
 if(/lisans|kurucu|şifre|hesap|doğrulama/.test(s))return "Bu prototipte güvenli hesap, kurucu yetkisi, lisans yönetimi ve doğrulama kodu sistemi etkin değil. Bunlar sunucu tarafında kimlik doğrulama ve yetkilendirmeyle uygulanmalıdır.";
 if(/fatura|e-fatura|resmî muhasebe/.test(s))return "Bu sürüm resmî e-fatura veya muhasebe sistemi değildir. Fatura entegrasyonu ve yasal gereklilikler için yetkili altyapı ve mevzuat uyumlu bir sunucu sistemi gerekir.";
 return "Sorunu daha ayrıntılı yazabilir misin? Şimdilik müşteri, stok, teknik servis, görev ve yedekleme işlemleri için kural tabanlı rehber sunabiliyorum. Bu rehber haricî üretken yapay zekâya bağlı değildir.";
}
function init(){
 document.getElementById("mainNav").addEventListener("click",e=>{
  const b=e.target.closest("button[data-page]");if(b&&!b.hidden)gotoPage(b.dataset.page);
 });
