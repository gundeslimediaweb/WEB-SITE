function exportFile(filename,content,mime="application/json"){
 const blob=new Blob([content],{type:mime+";charset=utf-8"}),url=URL.createObjectURL(blob),a=document.createElement("a");
 a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function backup(){
 const packet={app:"Gündeşli Soft Ofis360",version:2,exportedAt:new Date().toISOString(),data};
 exportFile("ofis360-yedek-"+today()+".json",JSON.stringify(packet,null,2));
 toast("Yedek dosyası oluşturuldu.");
}
function csvCell(v){
 let s=String(v??"");
 if(/^[=+\-@\t\r]/.test(s))s="'"+s;
 return '"'+s.replace(/"/g,'""')+'"';
}
function exportCSV(filename,headers,rows){
 const csv="\uFEFF"+[headers,...rows].map(row=>row.map(csvCell).join(";")).join("\r\n");
 exportFile(filename,csv,"text/csv");
}
