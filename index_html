 document.getElementById("mobileMenu").addEventListener("click",()=>document.getElementById("sidebar").classList.toggle("open"));
 document.getElementById("quickAdd").addEventListener("click",()=>{
  const options=data.sector==="computer"?["customer","stock","order","service","task"]:data.sector==="phone"?["customer","stock","order","service","phone","task"]:["customer","property","task"];
  const labels={customer:"Müşteri",stock:"Stok",order:"Satış / sipariş",service:"Teknik servis",property:"Gayrimenkul",phone:"Telefon cihazı",task:"Görev"};
  const answer=prompt("Yeni kayıt türünü yaz:\n"+options.map(x=>labels[x]).join("\n"));
  if(!answer)return;
  const type=options.find(x=>labels[x].toLocaleLowerCase("tr")===answer.trim().toLocaleLowerCase("tr"));
  if(type)openRecord(type);else toast("Listeden bir kayıt türü yazmalısın.");
 });
